# Timebound Server Environment
# Copy to .env and fill in values

# Generate a new secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# IMPORTANT: Change this before going live!
JWT_SECRET=CHANGE_ME_TO_RANDOM_SECRET

# Admin credentials (used only if admin-config.json doesn't exist yet)
ADMIN_USER=admin
ADMIN_PASS=admin123

# Optional: IP whitelist for admin panel (comma-separated)
# If set, ONLY these IPs can access /api/admin/* endpoints
# Example: ADMIN_IP_WHITELIST=86.120.100.50,2a02:2f0e:dead:beef::1
# Leave empty to allow any IP (but still requires auth)
ADMIN_IP_WHITELIST=

PORT=3000
